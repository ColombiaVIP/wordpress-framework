{
    "name": "colombiavip/wordpress-framework",
    "description": "Framework desarrollado para el CMS WordPress que hace uso del patrón de arquitectura mvc (modelo-vista-controlador), esto con la intención de ayudar y disminuir el tiempo de desarrollo de sistemas.",
    "type": "framework",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Fw\\": "Fw/",
            "WordpressFramework\\": "app/"
        }, 
        "files": [
            "Fw/helpers/assets.php",
            "Fw/helpers/general.php",
            "Fw/helpers/views.php"
        ]
    },
    "authors": [
        {
            "name": "ColombiaVIP",
            "email": "info@ColombiaVIP.com"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "dbout/wp-orm": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
